{
  "name": "filebe",
  "version": "1.1.0",
  "private": true,
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": { "node": ">=22.18.0 <23" },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run doctor",
    "doctor": "expo-doctor",
    "release:check": "node scripts/release-check.cjs",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "expo": "~58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "expo-status-bar": "~58.0.4",
    "expo-blur": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-sharing": "~58.0.21",
    "expo-secure-store": "~58.0.2",
    "expo-font": "~58.0.11",
    "expo-splash-screen": "~58.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-url-polyfill": "4.0.0",
    "@supabase/supabase-js": "2.118.0",
    "base64-arraybuffer": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/parser": "^7.26.0",
    "expo-doctor": "1.21.5"
  }
